 {
@@ -322,7 +323,32 @@
 add_required_seals_to_fd(int fd)
 {
    return fcntl(fd, F_ADD_SEALS, F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW);
+}
+#else
+/*
+ * macOS has no memfd seals. The render server still uses an anonymous,
+ * unlinked temporary file for the shared-memory metadata, so size validation
+ * remains useful while seal validation and mutation are intentionally omitted.
+ */
+static bool
+validate_resource_fd_shm(int fd, uint64_t expected_size)
+{
+   const uint64_t size = lseek(fd, 0, SEEK_END);
+   if (size != expected_size) {
+      proxy_log("failed to validate shm size(%" PRIu64 ") expected(%" PRIu64 ")", size,
+                expected_size);
+      return false;
+   }
+   return true;
+}
+
+static inline int
+add_required_seals_to_fd(int fd)
+{
+   (void)fd;
+   return 0;
 }
+#endif
 
